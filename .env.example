# ==========================================
# CareerOS Environment Configuration Template
# ==========================================

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Backend Application ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- Neo4j AuraDB (Free Tier) ---
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- Supabase (Auth & Storage) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_key
SUPABASE_STORAGE_BUCKET=resumes

# --- AI Inference Providers ---
# Google Gemini 1.5 Flash (via Google AI Studio)
GEMINI_API_KEY=AIzaSy...

# Groq LPU (Sub-second Outreach & Chat)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ingestion Tokens (Optional User Defaults) ---
GITHUB_DEFAULT_TOKEN=ghp_...

# --- Frontend Client Environment Variables ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_BASE_URL=http://localhost:8000
